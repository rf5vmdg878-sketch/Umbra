# Build output
**/target/
# Packaged archives from umbra-build
/dist/
# Linux SymCrypt fetched by umbra-build
unichat-common/vendor/symcrypt/linux/

# Vendored SymCrypt binary is not committed — fetch it (see
# unichat-common/vendor/symcrypt/README.md).
unichat-common/vendor/symcrypt/*.dll
unichat-common/vendor/symcrypt/*.lib
unichat-common/vendor/symcrypt/*.pdb
unichat-common/vendor/symcrypt/*.zip

# Runtime secrets / artifacts — never commit
*.profile
*.key
*.usealed
*.spool
*.tor-state/
*.tor-cache/
